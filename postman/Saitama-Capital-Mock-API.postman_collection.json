{
  "info": {
    "_postman_id": "b1a2c3d4-5e6f-4a1b-9c3d-7e8f9a0b1c2d",
    "name": "Saitama Capital Mock API",
    "description": "Users, Tickets, and Notes API (Netlify Functions + Netlify Blobs) for the Saitama Capital banking capstone.\n\nBefore running requests:\n1. Set the `baseUrl` collection variable (defaults to the deployed site).\n2. Set the `apiKey` collection variable to match the `API_KEY` environment variable configured on the Netlify site. Every endpoint requires it.\n\nSeed data note: 13 sample users (Star Wars characters) and any tickets you create are stored in Netlify Blobs and seeded automatically on first read.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://saitamaapi.netlify.app", "type": "string" },
    { "key": "apiKey", "value": "your-api-key-here", "type": "string" },
    { "key": "userId", "value": "usr_1002", "type": "string" },
    { "key": "userPhone", "value": "+15550001002", "type": "string" },
    { "key": "ticketId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          },
          "response": []
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get User(s) By Phone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/phone/{{userPhone}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "phone", "{{userPhone}}"]
            }
          },
          "response": []
        },
        {
          "name": "Search Users (name + phone + zipcode)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/search?name=Darth Maul&phone=+15550001011&zipcode=11011",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "search"],
              "query": [
                { "key": "name", "value": "Darth Maul" },
                { "key": "phone", "value": "+15550001011" },
                { "key": "zipcode", "value": "11011" }
              ]
            },
            "description": "All three query params are required - name, phone, and zipcode must all match the same user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "List All Tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [
                { "key": "status", "value": "open", "disabled": true },
                { "key": "email", "value": "john.doe@example.com", "disabled": true },
                { "key": "phone", "value": "+15551234567", "disabled": true }
              ]
            },
            "description": "Optional filters (disabled by default): status, email, phone."
          },
          "response": []
        },
        {
          "name": "Get Ticket By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('ticketId', body.ticket.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Stolen Credit Card Report\",\n  \"description\": \"Card lost at the gym.\",\n  \"requester\": {\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"phone\": \"+15551234567\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "description": "On success, the test script saves the new ticket's id into the `ticketId` collection variable for use by the Get/Update/Delete requests below."
          },
          "response": []
        },
        {
          "name": "Update Ticket",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"assignedAgent\": \"Agent Smith\",\n  \"lastUpdate\": \"Investigating the reported issue.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            },
            "description": "Partial update (PATCH semantics) - only send the fields you want to change."
          },
          "response": []
        },
        {
          "name": "Delete Ticket",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            },
            "description": "Returns 204 No Content on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "List Notes For Ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "notes"]
            },
            "description": "404s if {{ticketId}} doesn't match an existing ticket."
          },
          "response": []
        },
        {
          "name": "Add Note To Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Called customer back, awaiting card replacement.\",\n  \"author\": \"Agent Smith\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "notes"]
            },
            "description": "`author` is optional. 404s if {{ticketId}} doesn't match an existing ticket."
          },
          "response": []
        }
      ]
    }
  ]
}
